# Aláfíà Environment Variables
# Copy this file to .env.local and fill in your values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Aláfíà

# Database (add your DB connection when ready)
# DATABASE_URL=

# Auth (add NextAuth.js config when ready)
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000

# Maps API (for clinic discovery feature)
# NEXT_PUBLIC_MAPS_API_KEY=
